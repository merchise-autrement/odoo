<?xml version="1.0" encoding="utf-8"?>
<templates id="templates" xml:space="preserve">
  <t t-name="ProgressBar">
    <div class="progress">
      <t t-if="percent and progress and valuemin and valuemax">
        <div
          class="progress-bar progress-bar-info progress-bar-striped"
          role="progressbar"
          t-attr-aria-valuenow='progress'
          t-attr-aria-valuemin='valuemin'
          t-attr-aria-valuemax='valuemax'
          t-attr-style="'width: %d%%;' % percent"
        >
          <span aria-hidden="true" class="percent-message">
            <t t-raw="'%d%%' % percent"/>
          </span>
        </div>
      </t>
      <t t-if="!percent or !progress or !valuemin or !valuemax">
        <div
          class="progress-bar progress-bar-info progress-bar-striped"
          role="progressbar"
          style="width: 0%;"
        >
          <span aria-hidden="true" class="percent-message"/>
        </div>
      </t>
    </div>
  </t>
  <t t-name="StagedProgressBar">
    <!-- The actual stages are injected in JS using ProgressBar -->
    <div class="web-celery staged-progress-bars">
    </div>
  </t>
  <t t-name="CeleryProgressBar">
    <div class="web-celery progress-bar-container">
      <t t-if="widget.title">
        <h3 class="modal-title">
          <t t-raw="widget.title"/>
        </h3>
      </t>
      <t t-call="StagedProgressBar"/>
      <p class='message'>
        <t t-esc='widget.message'/>
      </p>
      <t t-if="widget.cancellable">
        <button
          name="cancel"
          type="button"
          aria-label="Cancel"
          class="btn btn-danger pull-right"
        >Cancel</button>
      </t>
    </div>
  </t>
  <t t-name="FullScreenProgressBar">
    <div class="web-celery full-screen-container">
      <t t-call="CeleryProgressBar"/>
    </div>
  </t>
</templates>
